<!doctype html> <!-- Deklarujemy dokument HTML5. -->
<html lang="pl"> <!-- Ustawiamy jezyk strony na polski. -->
<head> <!-- Sekcja head zawiera metadane. -->
    <meta charset="utf-8"> <!-- Ustawiamy kodowanie UTF-8. -->
    <meta name="viewport" content="width=device-width, initial-scale=1"> <!-- Ustawiamy responsywnosc strony. -->
    <title>#(product.name)</title> <!-- Tytul strony to nazwa produktu. -->
    <style>body{font-family:Arial,sans-serif;max-width:760px;margin:40px auto;padding:0 20px;line-height:1.5}a,button{display:inline-block;margin:6px 8px 6px 0;padding:8px 12px;border:1px solid #333;text-decoration:none;color:#111;background:#f4f4f4;cursor:pointer}form{display:inline}</style> <!-- Prosty styl szczegolow. -->
</head> <!-- Konczymy sekcje head. -->
<body> <!-- Rozpoczynamy tresc strony. -->
    <h1>#(product.name)</h1> <!-- Wyswietlamy nazwe produktu. -->
    <p><strong>Kategoria:</strong> #(product.categoryName)</p> <!-- Wyswietlamy kategorie produktu. -->
    <p><strong>Opis:</strong> #(product.description)</p> <!-- Wyswietlamy opis produktu. -->
    <p><strong>Cena:</strong> #(product.price)</p> <!-- Wyswietlamy cene produktu. -->
    <p><strong>Stan magazynowy:</strong> #(product.stock)</p> <!-- Wyswietlamy stan magazynowy. -->
    <a href="/products">Wroc</a> <!-- Link wraca do listy produktow. -->
    <a href="/products/#(product.id)/edit">Edytuj</a> <!-- Link otwiera edycje produktu. -->
    <form method="post" action="/products/#(product.id)/delete"> <!-- Formularz usuwa produkt. -->
        <button type="submit">Usun</button> <!-- Przycisk usuwa produkt. -->
    </form> <!-- Konczymy formularz usuwania. -->
</body> <!-- Konczymy tresc strony. -->
</html> <!-- Konczymy dokument HTML. -->
