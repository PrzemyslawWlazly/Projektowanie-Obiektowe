<!doctype html> <!-- Deklarujemy dokument HTML5. -->
<html lang="pl"> <!-- Ustawiamy jezyk strony na polski. -->
<head> <!-- Sekcja head zawiera metadane. -->
    <meta charset="utf-8"> <!-- Ustawiamy kodowanie UTF-8. -->
    <meta name="viewport" content="width=device-width, initial-scale=1"> <!-- Ustawiamy responsywnosc strony. -->
    <title>#(title)</title> <!-- Tytul strony pochodzi z kontrolera. -->
    <style>body{font-family:Arial,sans-serif;max-width:760px;margin:40px auto;padding:0 20px;line-height:1.5}a,button{display:inline-block;margin:6px 8px 6px 0;padding:8px 12px;border:1px solid #333;text-decoration:none;color:#111;background:#f4f4f4;cursor:pointer}label{font-weight:bold}input,textarea{width:100%;padding:8px;margin:4px 0 14px;box-sizing:border-box}</style> <!-- Prosty styl formularza. -->
</head> <!-- Konczymy sekcje head. -->
<body> <!-- Rozpoczynamy tresc strony. -->
    <h1>#(title)</h1> <!-- Wyswietlamy tytul formularza. -->
    <nav> <!-- Nawigacja formularza. -->
        <a href="/categories">Kategorie</a> <!-- Link wraca do kategorii. -->
        <a href="/products">Produkty</a> <!-- Link prowadzi do produktow. -->
    </nav> <!-- Konczymy nawigacje. -->
    <form method="post" action="#(action)"> <!-- Formularz wysyla dane kategorii. -->
        <label for="name">Nazwa</label> <!-- Etykieta pola nazwy. -->
        <input id="name" name="name" value="#(name)" required> <!-- Pole nazwy kategorii. -->
        <label for="description">Opis</label> <!-- Etykieta pola opisu. -->
        <textarea id="description" name="description" required>#(description)</textarea> <!-- Pole opisu kategorii. -->
        <button type="submit">#(submitLabel)</button> <!-- Przycisk zapisuje formularz. -->
    </form> <!-- Konczymy formularz kategorii. -->
</body> <!-- Konczymy tresc strony. -->
</html> <!-- Konczymy dokument HTML. -->
